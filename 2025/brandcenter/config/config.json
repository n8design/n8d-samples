{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "typography-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/typography/TypographyWebPart.js",
          "manifest": "./src/webparts/typography/TypographyWebPart.manifest.json"
        }
      ]
    },
    "brand-colors-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/brandColors/BrandColorsWebPart.js",
          "manifest": "./src/webparts/brandColors/BrandColorsWebPart.manifest.json"
        }
      ]
    },
    "brand-center-showcase-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/brandCenterShowcase/BrandCenterShowcaseWebPart.js",
          "manifest": "./src/webparts/brandCenterShowcase/BrandCenterShowcaseWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "TypographyWebPartStrings": "lib/webparts/typography/loc/{locale}.js",
    "BrandColorsWebPartStrings": "lib/webparts/brandColors/loc/{locale}.js",
    "BrandCenterShowcaseWebPartStrings": "lib/webparts/brandCenterShowcase/loc/{locale}.js"
  }
}
